<mxfile host="app.diagrams.net" type="device" compressed="false"><diagram id="arch" name="Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-t1" value="&lt;b&gt;Race Engineer Adaptive Harness: architecture. A race engineer agent briefs safety-car (SC) and virtual-safety-car (VSC) history from public FastF1 timing data, inside a self-improving harness.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1500" height="30" as="geometry"/></mxCell><mxCell id="arch-n2" value="&lt;b&gt;Runner: one bounded discussion per case run (stages from the pinned configuration)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=14;arcSize=8;align=center;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="910" height="360" as="geometry"/></mxCell><mxCell id="arch-n3" value="&lt;b&gt;S1&lt;/b&gt;&lt;br&gt;frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="95" height="50" as="geometry"/></mxCell><mxCell id="arch-n4" value="&lt;b&gt;S2a&lt;/b&gt;&lt;br&gt;assess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="175" y="72" width="95" height="45" as="geometry"/></mxCell><mxCell id="arch-n5" value="&lt;b&gt;S2b&lt;/b&gt;&lt;br&gt;assess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="175" y="132" width="95" height="45" as="geometry"/></mxCell><mxCell id="arch-n6" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;challenge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="95" height="50" as="geometry"/></mxCell><mxCell id="arch-n7" value="&lt;b&gt;S4&lt;/b&gt;&lt;br&gt;gather" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="100" width="95" height="50" as="geometry"/></mxCell><mxCell id="arch-n8" value="&lt;b&gt;S5&lt;/b&gt;&lt;br&gt;estimate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="95" height="50" as="geometry"/></mxCell><mxCell id="arch-n9" value="&lt;b&gt;S6&lt;/b&gt;&lt;br&gt;brief" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="635" y="100" width="95" height="50" as="geometry"/></mxCell><mxCell id="arch-n10" value="&lt;b&gt;S7 validate (code)&lt;/b&gt;&lt;br&gt;schema + enabled catalog checks; one repair round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="85" width="180" height="80" as="geometry"/></mxCell><mxCell id="arch-e11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n3" target="arch-n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n3" target="arch-n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n4" target="arch-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n5" target="arch-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n6" target="arch-n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n7" target="arch-n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n8" target="arch-n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="arch-n9" target="arch-n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e19" value="repair (once)" style="endArrow=block;endFill=1;html=1;strokeColor=#1f5fbf;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n10" target="arch-n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="190"/><mxPoint x="682" y="190"/></Array></mxGeometry></mxCell><mxCell id="arch-t20" value="S2a and S2b run in parallel, blind to each other" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="175" y="180" width="200" height="20" as="geometry"/></mxCell><mxCell id="arch-n21" value="&lt;b&gt;Race engineer&lt;/b&gt;&lt;br&gt;Claude Opus 5.5&lt;br&gt;S1 frame, S3 challenge, S6 brief" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="280" height="80" as="geometry"/></mxCell><mxCell id="arch-n22" value="&lt;b&gt;Statistician&lt;/b&gt;&lt;br&gt;Claude Sonnet 5&lt;br&gt;S2a assess, S3 challenge, S5 estimate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="355" y="215" width="280" height="80" as="geometry"/></mxCell><mxCell id="arch-n23" value="&lt;b&gt;Data engineer&lt;/b&gt;&lt;br&gt;Claude Sonnet 5&lt;br&gt;S2b assess, S3 challenge, S4 gather" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="650" y="215" width="280" height="80" as="geometry"/></mxCell><mxCell id="arch-n24" value="&lt;b&gt;Coordinator&lt;/b&gt;&lt;br&gt;assembles each role's context from the context_policy (task, schema, tool docs, prior stages, top 3 verified lessons at the first stage); budgets per case run: 40 model calls, 60 tool calls, 900 s; writes every event in order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="870" height="75" as="geometry"/></mxCell><mxCell id="arch-n25" value="&lt;b&gt;Data tools (as-of guard)&lt;/b&gt;&lt;br&gt;list_events, race_control_messages, track_status (race data); interval (Wilson 90% interval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#555555;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="430" height="90" as="geometry"/></mxCell><mxCell id="arch-n26" value="&lt;b&gt;FastF1 cache&lt;/b&gt;&lt;br&gt;public timing data, fetched at runtime into FASTF1_CACHE_DIR outside the repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#555555;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="430" height="70" as="geometry"/></mxCell><mxCell id="arch-n27" value="&lt;b&gt;Fixed evaluator (separate process)&lt;/b&gt;&lt;br&gt;python -m adaptive_harness.evaluate&lt;br&gt;checks E1 to E8 per case run; records evaluator and key SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1dcff;strokeColor=#7b1fa2;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="440" width="440" height="100" as="geometry"/></mxCell><mxCell id="arch-n28" value="&lt;b&gt;Answer key: data/key.json&lt;/b&gt;&lt;br&gt;hash in data/key.sha256; committed before any harness code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1dcff;strokeColor=#7b1fa2;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="580" width="440" height="70" as="geometry"/></mxCell><mxCell id="arch-n29" value="&lt;b&gt;DMAIC improvement agent (Claude Opus 5.5)&lt;/b&gt;&lt;br&gt;fixed prompt per phase: define, measure, analyze, improve, control; every tollgate decided by code; sees development-case evidence only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="910" height="95" as="geometry"/></mxCell><mxCell id="arch-e30" value="S4 tool calls (args, as_of)&lt;br&gt;tool results" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n24" target="arch-n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="739" y="420"/><mxPoint x="362" y="420"/></Array></mxGeometry></mxCell><mxCell id="arch-e31" value="reads" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="arch-n25" target="arch-n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e32" value="read only by the evaluator" style="endArrow=block;endFill=1;html=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="arch-n28" target="arch-n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-n33" value="&lt;b&gt;MongoDB Atlas: six collections&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fbf2;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=14;arcSize=8;align=center;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="40" width="580" height="760" as="geometry"/></mxCell><mxCell id="arch-n34" value="&lt;b&gt;runs&lt;/b&gt;&lt;br&gt;_id run_id; harness_version, config_hash, memory_snapshot (M0 or M1), arm, model assignment, fastf1_version, status, totals, output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2d9;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="540" height="95" as="geometry"/></mxCell><mxCell id="arch-n35" value="&lt;b&gt;events&lt;/b&gt;&lt;br&gt;_id run_id:seq; type (model_call, tool_call, tool_result, message, decision, check, error), content, refs, context_manifest, usage&lt;br&gt;unique index run_seq (run_id, seq): idempotent writes; partial index control_checks (content.version, type) where content.control exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2d9;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="185" width="540" height="110" as="geometry"/></mxCell><mxCell id="arch-n36" value="&lt;b&gt;harness_versions&lt;/b&gt;&lt;br&gt;config, config_hash, parent, changes with reasons, validation, status, control_plan&lt;br&gt;partial unique index one_pinned: a single pinned version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2d9;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="305" width="540" height="95" as="geometry"/></mxCell><mxCell id="arch-n37" value="&lt;b&gt;lessons&lt;/b&gt;&lt;br&gt;verified root causes: why-chain, source events, text, snapshot, embedding (BAAI/bge-small-en-v1.5, 384 dims)&lt;br&gt;Atlas Vector Search index lessons_vector, cosine, filter fields scope, status, snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2d9;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="410" width="540" height="110" as="geometry"/></mxCell><mxCell id="arch-n38" value="&lt;b&gt;evaluations&lt;/b&gt;&lt;br&gt;per run: checks E1 to E8 (PASS, FAIL, HARNESS, NA), opportunities, defects, evaluator_sha256, key_sha256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2d9;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="530" width="540" height="85" as="geometry"/></mxCell><mxCell id="arch-n39" value="&lt;b&gt;experiments&lt;/b&gt;&lt;br&gt;one per cycle: cases, arms, each phase's artifact and tollgate, acceptance R0 to R4, decision, candidate_version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2d9;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="625" width="540" height="95" as="geometry"/></mxCell><mxCell id="arch-t40" value="Only the pinned version runs by default; the pin is enforced by the one_pinned index. Lesson retrieval uses $vectorSearch with a pre-filter on snapshot, status and scope, so runs on M0 never see M1 lessons." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1020" y="730" width="540" height="60" as="geometry"/></mxCell><mxCell id="arch-e41" value="every model call, tool call, result,&lt;br&gt;message, check, decision" style="endArrow=block;endFill=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n24" target="arch-n35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="347"/><mxPoint x="975" y="240"/></Array></mxGeometry></mxCell><mxCell id="arch-e42" value="run document and totals" style="endArrow=block;endFill=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n24" target="arch-n34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="325"/><mxPoint x="965" y="127"/></Array></mxGeometry></mxCell><mxCell id="arch-e43" value="pinned configuration" style="endArrow=block;endFill=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n36" target="arch-n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="333"/><mxPoint x="985" y="25"/><mxPoint x="107" y="25"/></Array></mxGeometry></mxCell><mxCell id="arch-e44" value="top 3 verified lessons&lt;br&gt;($vectorSearch, snapshot pre-filter)" style="endArrow=block;endFill=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n37" target="arch-n24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="465"/><mxPoint x="980" y="370"/></Array></mxGeometry></mxCell><mxCell id="arch-e45" value="outputs and tool_result events" style="endArrow=block;endFill=1;html=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n35" target="arch-n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e46" value="verdicts per check" style="endArrow=block;endFill=1;html=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n27" target="arch-n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e47" value="development-case verdicts only" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n38" target="arch-n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e48" value="verified root causes" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n29" target="arch-n37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e49" value="candidate version,&lt;br&gt;pin on acceptance" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n29" target="arch-n36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="757"/><mxPoint x="990" y="381"/></Array></mxGeometry></mxCell><mxCell id="arch-e50" value="phase artifacts, tollgates,&lt;br&gt;R0 to R4, decision" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n29" target="arch-n39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e51" value="pilot arms: memory_only, candidate" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-n29" target="arch-n24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="747"/><mxPoint x="20" y="347"/></Array></mxGeometry></mxCell><mxCell id="arch-t52" value="Palette: blue = runner and roles; grey = data tools; purple = evaluator and answer key; amber = improvement; green = MongoDB Atlas. This project is unofficial and is not associated with the Formula 1 companies." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1540" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dmaic" name="DMAIC cycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dmaic-t1" value="&lt;b&gt;DMAIC cycle: the improvement agent writes each phase's text; code decides every tollgate; the cycle stops at the first tollgate that does not pass.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1480" height="30" as="geometry"/></mxCell><mxCell id="dmaic-n2" value="&lt;b&gt;Baseline arm&lt;/b&gt;&lt;br&gt;pinned version on M0, six cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=13;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="80" as="geometry"/></mxCell><mxCell id="dmaic-n3" value="&lt;b&gt;Define&lt;/b&gt;&lt;br&gt;charter from development cases; problem statement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="170" height="80" as="geometry"/></mxCell><mxCell id="dmaic-n4" value="&lt;b&gt;Measure&lt;/b&gt;&lt;br&gt;hashes, fresh re-score, DPO, Pareto, cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="170" height="80" as="geometry"/></mxCell><mxCell id="dmaic-n5" value="&lt;b&gt;Analyze&lt;/b&gt;&lt;br&gt;root causes with why-chains, verified against events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="80" width="170" height="80" as="geometry"/></mxCell><mxCell id="dmaic-n6" value="&lt;b&gt;Improve&lt;/b&gt;&lt;br&gt;proposal, validator, pilot, R0 to R4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="80" width="170" height="80" as="geometry"/></mxCell><mxCell id="dmaic-n7" value="&lt;b&gt;Control&lt;/b&gt;&lt;br&gt;pin, control plan, optional confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1350" y="80" width="170" height="80" as="geometry"/></mxCell><mxCell id="dmaic-e8" value="evaluator verdicts" style="endArrow=block;endFill=1;html=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n2" target="dmaic-n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e9" value="Tollgate D:&lt;br&gt;at least one&lt;br&gt;development defect" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n3" target="dmaic-n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e10" value="Tollgate M:&lt;br&gt;hashes match, re-score&lt;br&gt;identical, no HARNESS" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n4" target="dmaic-n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e11" value="Tollgate A: at least&lt;br&gt;one verified controllable&lt;br&gt;root cause" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n5" target="dmaic-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e12" value="Tollgate I:&lt;br&gt;R0 to R4 all hold" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n6" target="dmaic-n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-n13" value="&lt;b&gt;Stop&lt;/b&gt;&lt;br&gt;at the first tollgate that does not pass; recorded as the experiment's outcome, not as an error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9d9;strokeColor=#c62828;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="420" height="70" as="geometry"/></mxCell><mxCell id="dmaic-e14" value="fails" style="endArrow=block;endFill=1;html=1;strokeColor=#c62828;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dmaic-n3" target="dmaic-n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-n15" value="&lt;b&gt;lessons (snapshot M1)&lt;/b&gt;&lt;br&gt;verified root causes with embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f2d9;strokeColor=#2e7d32;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="230" width="250" height="70" as="geometry"/></mxCell><mxCell id="dmaic-e16" value="writes" style="endArrow=block;endFill=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dmaic-n5" target="dmaic-n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-n17" value="&lt;b&gt;Improve phase in detail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#1a1a1a;fontSize=14;arcSize=8;align=center;spacing=6;verticalAlign=top;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="340" width="1000" height="470" as="geometry"/></mxCell><mxCell id="dmaic-n18" value="&lt;b&gt;Proposal (improvement agent)&lt;/b&gt;&lt;br&gt;up to 3 JSON Patch changes on /stages, /context_policy or /checks, each citing a verified root cause; rationale, expected effect, risks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="230" height="110" as="geometry"/></mxCell><mxCell id="dmaic-n19" value="&lt;b&gt;Validator (code)&lt;/b&gt;&lt;br&gt;paths and bounds, change cap 3, citation category matches surface, schema; refuses an exact repeat of a rejected change set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#b8860b;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="400" width="230" height="110" as="geometry"/></mxCell><mxCell id="dmaic-n20" value="&lt;b&gt;Pilot, fresh runs, same six cases, snapshot M1&lt;/b&gt;&lt;br&gt;arm memory_only: current version + new lessons&lt;br&gt;arm candidate: candidate version + same lessons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe9ff;strokeColor=#1f5fbf;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="400" width="340" height="110" as="geometry"/></mxCell><mxCell id="dmaic-n21" value="&lt;b&gt;Acceptance rules (evaluator process)&lt;/b&gt;&lt;br&gt;R0 validity: no HARNESS after one rerun&lt;br&gt;R1 no regression on control cases&lt;br&gt;R2 strictly more development checks passed&lt;br&gt;R3 at least as many held-out checks&lt;br&gt;R4 wall-clock at most 1.5 times" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1dcff;strokeColor=#7b1fa2;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="570" width="340" height="170" as="geometry"/></mxCell><mxCell id="dmaic-n22" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;candidate marked rejected; current version stays pinned; reasons stored in harness_versions and experiments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9d9;strokeColor=#c62828;fontColor=#1a1a1a;fontSize=12;arcSize=8;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="610" width="300" height="110" as="geometry"/></mxCell><mxCell id="dmaic-e23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dmaic-n6" target="dmaic-n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="370"/><mxPoint x="675" y="370"/></Array></mxGeometry></mxCell><mxCell id="dmaic-e24" value="change set" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n18" target="dmaic-n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e25" value="valid: candidate version" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n19" target="dmaic-n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e26" value="verdicts of both arms" style="endArrow=block;endFill=1;html=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;" edge="1" parent="1" source="dmaic-n20" target="dmaic-n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e27" value="any rule fails" style="endArrow=block;endFill=1;html=1;strokeColor=#c62828;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dmaic-n21" target="dmaic-n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dmaic-e28" value="all hold" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dmaic-n21" target="dmaic-n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="621"/><mxPoint x="1500" y="180"/><mxPoint x="1435" y="180"/></Array></mxGeometry></mxCell><mxCell id="dmaic-e29" value="proposal history in later cycles:&lt;br&gt;each earlier change set with its&lt;br&gt;development-case outcome" style="endArrow=block;endFill=1;html=1;strokeColor=#b8860b;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dmaic-n22" target="dmaic-n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="665"/><mxPoint x="540" y="455"/></Array></mxGeometry></mxCell><mxCell id="dmaic-e30" value="refused proposals&lt;br&gt;also enter the history" style="endArrow=block;endFill=1;html=1;strokeColor=#c62828;strokeWidth=2;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;rounded=1;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dmaic-n19" target="dmaic-n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="560"/><mxPoint x="732" y="560"/></Array></mxGeometry></mxCell><mxCell id="dmaic-t31" value="Control (after acceptance): the accepted version is pinned by its configuration hash; each case's threshold is the number of checks it passed in the pilot. A later run below threshold is a signal: rerun once; if it repeats, pin the previous version, mark the candidate rolled_back, and open a new cycle on development-case evidence only. Runs under a different model assignment or FastF1 version are flagged, not compared." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="440" height="200" as="geometry"/></mxCell><mxCell id="dmaic-t32" value="Evidence rule: only development cases (D1, D2) inform define, analyze, and any prompt the improvement agent sees. Held-out (H1, H2) and control (P1, P2) results are used only by code, to verify and to control." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="440" height="120" as="geometry"/></mxCell><mxCell id="dmaic-t33" value="This project is unofficial and is not associated with the Formula 1 companies." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1480" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="time" name="Build timeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1300" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="time-t1" value="&lt;b&gt;Build timeline, 2026-09-26 (EDT, from git log; experiment times from run ids converted from UTC). Lane branches merge into main.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#1a1a1a;" v