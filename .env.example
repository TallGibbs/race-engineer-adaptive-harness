# Copy to .env and fill in. Never commit .env.
MONGODB_URI=
MONGODB_DB=adaptive_harness

# One provider and one key serve every role.
MODEL_PROVIDER=
# Default model for every role.
MODEL_NAME=
# Optional per-role overrides; when unset or empty the role uses MODEL_NAME.
MODEL_NAME_RACE_ENGINEER=
MODEL_NAME_STATISTICIAN=
MODEL_NAME_DATA_ENGINEER=
MODEL_NAME_IMPROVEMENT=
# Only for OpenAI-compatible providers; leave empty otherwise.
MODEL_BASE_URL=
MODEL_API_KEY=

FASTF1_CACHE_DIR=
FASTF1_OFFLINE=0
